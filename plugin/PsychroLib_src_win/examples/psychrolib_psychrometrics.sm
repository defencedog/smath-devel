    <region left="18" top="6624" width="746" height="347" color="#000000" fontSize="10">
      <xyplot animFrameRate="20" animPlaybackMode="RepeatIndefinitely" width="736" height="339" points="100" name="XYPlot" keepAspectRatio="false">
        <chartstyle usedefault="false" backcolor="White" bordercolor="Black" />
        <grid gridcolor="LightGray" gridpattern="Dash" gridthickness="1" isxgrid="true" isygrid="true" isy2grid="false" />
        <xaxes xmin="-20" xmax="50" xtick="10" visible="True" decimalplaces="3" numberformat="General" />
        <yaxes ymin="0" ymax="13" ytick="2" visible="True" decimalplaces="3" numberformat="General" />
        <y2axes isy2axis="false" y2min="-1" y2max="1" y2tick="0.5" visible="True" decimalplaces="3" numberformat="General" />
        <title2d title="Water Vapor Saturation Pressure pws(T)" titlefont="DejaVu Sans, 10pt" titlefontcolor="Black" />
        <xylabel labelfont="DejaVu Sans, 10pt" labelfontcolor="Black" tickfont="DejaVu Sans, 8pt" tickfontcolor="Black" xlabel="Temperature T [°C]" ylabel="Saturation Pressure pws [kPa]" y2label="y2" />
