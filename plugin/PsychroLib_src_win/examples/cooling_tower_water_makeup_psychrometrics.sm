      </region>
      <region left="18" top="6795" width="98" height="24" color="#000000" fontSize="10">
        <math decimalPlaces="4">
          <description active="true" position="Top" lang="eng">
            <content>
          <p>Sub-step midpoint depth register zM [m]</p>
        </content>
          </description>
          <input>
            <e type="operand">zM_reg</e>
            <e type="operand">0</e>
            <e type="operand" style="unit">m</e>
            <e type="operator" args="2">*</e>
            <e type="operator" args="2">:</e>
          </input>
        </math>
      </region>
