      </region>
      <region left="18" top="6732" width="106" height="24" color="#000000" fontSize="10">
        <math decimalPlaces="4">
          <description active="true" position="Top" lang="eng">
            <content>
          <p>Sub-step water temperature register tw0 [K]</p>
        </content>
          </description>
          <input>
            <e type="operand">tw0_reg</e>
            <e type="operand">0</e>
            <e type="operand" style="unit">K</e>
            <e type="operator" args="2">*</e>
            <e type="operator" args="2">:</e>
