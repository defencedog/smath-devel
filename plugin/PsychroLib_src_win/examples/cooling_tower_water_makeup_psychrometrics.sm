    <region left="18" top="12771" width="763" height="71" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="DejaVu Sans" fontSize="10">
        <content>
    <p bold="true">Visualization 5: Seasonal Wet-Bulb Sensitivity &amp; Basin Cold Water Temperature</p>
    <p bold="true">Performance curve of basin cold water temperature and approach as ambient wet-bulb varies from 16 °C to 28 °C.</p>
    </content>
      </text>
    </region>
    <region left="18" top="12861" width="141" height="136" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Seasonal ambient wet-bulb temperature variations: [16 ... 28] °C</p>
      </content>
        </description>
        <input>
          <e type="operand">Twb_sens_C</e>
          <e type="operand">16</e>
          <e type="operand">18</e>
          <e type="operand">20</e>
          <e type="operand">22</e>
          <e type="operand">24</e>
          <e type="operand">26</e>
          <e type="operand">28</e>
          <e type="operand">7</e>
          <e type="operand">1</e>
          <e type="function" args="9">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="13032" width="303" height="30" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Cooling tower approach across wet-bulb range: [7.3 ... 5.5] K</p>
      </content>
        </description>
        <input>
          <e type="operand">app_sens_C</e>
          <e type="operand">5.8</e>
          <e type="operand">0.15</e>
          <e type="operand">26</e>
          <e type="operand">Twb_sens_C</e>
          <e type="operator" args="2">-</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">+</e>
          <e type="function" args="1">vectorize</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="13095" width="290" height="30" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Cold water basin supply temperature: [23.3 ... 33.5] °C</p>
      </content>
        </description>
        <input>
          <e type="operand">Tcw_sens_C</e>
          <e type="operand">Twb_sens_C</e>
          <e type="operand">app_sens_C</e>
          <e type="operator" args="2">+</e>
          <e type="function" args="1">vectorize</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="13158" width="233" height="30" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Plant maximum design cold water supply limit: 35.0 °C</p>
      </content>
        </description>
        <input>
          <e type="operand">Tcw_limit</e>
          <e type="operand">0</e>
          <e type="operand">Twb_sens_C</e>
          <e type="operator" args="2">*</e>
          <e type="operand">35</e>
          <e type="operator" args="2">+</e>
          <e type="function" args="1">vectorize</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="13230" width="365" height="25" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>XY curve: wet-bulb temperature vs cold water temperature</p>
      </content>
        </description>
        <input>
          <e type="operand">xy_tcw_sens</e>
