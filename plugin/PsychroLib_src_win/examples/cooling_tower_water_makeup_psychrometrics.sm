          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="12276" width="706" height="27" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Closed polygon for blowdown requirement and water savings band</p>
      </content>
        </description>
        <input>
          <e type="operand">band_water_saving</e>
          <e type="operand">xy_mu_curve</e>
          <e type="operand">coc_grid</e>
          <e type="function" args="1">reverse</e>
