        <xylabel labelfont="DejaVu Sans, 10pt" labelfontcolor="Black" tickfont="DejaVu Sans, 8pt" tickfontcolor="Black" xlabel="Cycles of Concentration (CoC)" ylabel="Volumetric Flow Rate [m³/h]" y2label="y2" />
