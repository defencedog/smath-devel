          <trace seriesname="Total Makeup Water Demand M [m³/h]" isy2data="false" isvisible="true" plotmethod="Lines" lineantialias="true" linecolor="DarkSlateGray" linethickness="1" linepattern="Solid" fillmode="Auto" filltotrace="-1" filled="false" hatched="false" fillcolor="64, 0, 0, 255" hatchstyle="Percent20" symbolantialias="true" symbolsize="8" symboltype="Circle" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />
          <trace seriesname="Evaporation Loss E = 15.21 m³/h" isy2data="false" isvisible="true" plotmethod="Lines" lineantialias="true" linecolor="Firebrick" linethickness="1" linepattern="Solid" fillmode="Auto" filltotrace="-1" filled="false" hatched="false" fillcolor="64, 0, 0, 255" hatchstyle="Percent20" symbolantialias="true" symbolsize="8" symboltype="None" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />
          <trace seriesname="Blowdown Discharge Rate B [m³/h]" isy2data="false" isvisible="true" plotmethod="Lines" lineantialias="true" linecolor="RoyalBlue" linethickness="1" linepattern="Solid" fillmode="Auto" filltotrace="-1" filled="false" hatched="false" fillcolor="64, 0, 0, 255" hatchstyle="Percent20" symbolantialias="true" symbolsize="8" symboltype="Diamond" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />
