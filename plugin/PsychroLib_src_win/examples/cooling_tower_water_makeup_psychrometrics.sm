    <region left="18" top="4806" width="760" height="55" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="DejaVu Sans" fontSize="10">
        <content>
    <p bold="true">Section 5: Merkel Theory &amp; Cooling Tower Transfer Number (Me = KaV/L)</p>
    <p bold="true">Evaluation of the Merkel cooling tower characteristic integral and CTI 4-point Chebyshev numerical quadrature.</p>
    </content>
      </text>
    </region>
    <region left="18" top="4869" width="402" height="25" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Air operating line enthalpy: h_a(Tw) = h_in + (L/G)*cp_w*(Tw - T_out)</p>
      </content>
        </description>
        <input>
          <e type="operand">Tw</e>
          <e type="function" args="1">h_air_op</e>
          <e type="operand">h_a_in</e>
          <e type="operand">LG_ratio</e>
          <e type="operand">cp_w</e>
          <e type="operator" args="2">*</e>
          <e type="operand">Tw</e>
          <e type="operand">T_w_out</e>
          <e type="operator" args="2">-</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">+</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="4932" width="488" height="26" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Saturated air enthalpy at water temperature: h_sat(Tw)</p>
      </content>
        </description>
        <input>
          <e type="operand">Tw</e>
          <e type="function" args="1">h_sat_w</e>
          <e type="operand">Tw</e>
          <e type="operand">Tw</e>
          <e type="operand">1</e>
          <e type="operand">P_atm</e>
          <e type="function" args="3">Psy_HumRatio_RH</e>
          <e type="function" args="2">Psy_Enthalpy</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="4995" width="401" height="42" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
