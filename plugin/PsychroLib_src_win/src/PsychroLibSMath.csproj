<?xml version="1.0" encoding="utf-8"?>
<!--
  PsychroLib SMath plugin — legacy (non-SDK) project.

  Why not SDK-style? SMath plugins must target .NET Framework 2.0 (CLR 2.0) so
  they also load under Mono on Linux. An SDK-style project would need a NuGet
  restore step; this project instead references the reference assemblies and the
  SMath assemblies directly by path, so `dotnet build` works offline.

  Paths are relative to the repository root. `build.ps1` populates `packages/`
  (git-ignored). Any of the three properties below can be overridden on the
  command line, e.g.
      dotnet build src/PsychroLibSMath.csproj -p:PackagesPath=D:\refs
-->
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{7F3C1D92-4A8B-4E2C-9D61-5B0A8E4F2C37}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>PsychroLibSMath</RootNamespace>
    <AssemblyName>PsychroLibWrapper</AssemblyName>
    <TargetFrameworkVersion>v2.0</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS0649;CS0169</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>2</WarningLevel>
  </PropertyGroup>

  <!-- Reference locations. Everything is relative to the repo root so the tree
       is portable; override on the command line if your packages live elsewhere. -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)..\</RepoRoot>
    <PackagesPath Condition=" '$(PackagesPath)' == '' ">$(RepoRoot)packages</PackagesPath>
    <NetRefPath Condition=" '$(NetRefPath)' == '' ">$(PackagesPath)\microsoft.netframework.referenceassemblies.net20.1.0.3\build\.NETFramework\v2.0</NetRefPath>
    <SMathRefPath Condition=" '$(SMathRefPath)' == '' ">$(PackagesPath)</SMathRefPath>
    <TargetFrameworkRootPath Condition=" '$(TargetFrameworkRootPath)' == '' ">$(PackagesPath)\microsoft.netframework.referenceassemblies.net20.1.0.3\build\</TargetFrameworkRootPath>
  </PropertyGroup>

  <!-- .NET Framework 2.0 reference assemblies (Microsoft.NETFramework.ReferenceAssemblies.net20) -->
  <ItemGroup>
    <Reference Include="mscorlib">
      <HintPath>$(NetRefPath)\mscorlib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System">
      <HintPath>$(NetRefPath)\System.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Data">
      <HintPath>$(NetRefPath)\System.Data.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Xml">
      <HintPath>$(NetRefPath)\System.Xml.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Drawing">
      <HintPath>$(NetRefPath)\System.Drawing.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- SMath Studio assemblies (provided by the host at runtime, so Private=False) -->
  <ItemGroup>
    <Reference Include="SMath.Manager">
      <HintPath>$(SMathRefPath)\smathstudio.core.ref.1.73.9126\ref\net20\SMath.Manager.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SMath.Math.Numeric">
      <HintPath>$(SMathRefPath)\smathstudio.core.ref.1.73.9126\ref\net20\SMath.Math.Numeric.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SMath.Math.Symbolic">
      <HintPath>$(SMathRefPath)\smathstudio.core.ref.1.73.9126\ref\net20\SMath.Math.Symbolic.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SMath.Controls">
      <HintPath>$(SMathRefPath)\smathstudio.core.ref.1.73.9126\ref\net20\SMath.Controls.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SMath.Drawing">
      <HintPath>$(SMathRefPath)\smathstudio.drawing.ref.1.4.0\ref\net20\SMath.Drawing.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="psychrolib.cs" />
    <Compile Include="Psy.cs" />
    <Compile Include="Functions.cs" />
    <Compile Include="Units.cs" />
    <Compile Include="Plugin.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
