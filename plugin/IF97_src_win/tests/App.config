<?xml version="1.0" encoding="utf-8"?>
<!--
  The harness is compiled for .NET Framework 2.0 to match the plugin, but this
  machine only has the CLR 4 runtime. Without this file a net20 EXE exits with
  0x80131700 before printing anything; this rolls it forward to CLR 4.
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
</configuration>
