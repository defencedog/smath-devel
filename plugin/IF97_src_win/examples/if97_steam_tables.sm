  <region left="18" top="1949" width="500" height="56" color="#000000" fontSize="10">
  <text lang="eng" fontFamily="DejaVu Sans" fontSize="10">
    <content>
    <p bold="true">Visualization 1: Water Vapor Pressure Saturation Curve Psat(T)</p>
    <p bold="true">Clausius-Clapeyron exponential vapor pressure rise spanning 10 °C up to near-critical 370 °C (210 bar).</p>
    </content>
  </text>
  </region>
  <region left="18" top="2017" width="252" height="261" color="#000000" fontSize="10">
  <math>
    <description active="true" position="Top" lang="eng">
      <content>
        <p>Temperature nodes for vapor pressure curve: [10 ... 370] °C (283.15 ... 643.15 K)</p>
      </content>
    </description>
    <input>
    <e type="operand">T_sat_nodes</e>
    <e type="operand">283.15</e>
    <e type="operand">303.15</e>
    <e type="operand">323.15</e>
    <e type="operand">343.15</e>
    <e type="operand">363.15</e>
    <e type="operand">373.15</e>
    <e type="operand">393.15</e>
    <e type="operand">423.15</e>
    <e type="operand">453.15</e>
    <e type="operand">483.15</e>
    <e type="operand">523.15</e>
    <e type="operand">573.15</e>
    <e type="operand">623.15</e>
    <e type="operand">643.15</e>
    <e type="operand">14</e>
    <e type="operand">1</e>
    <e type="function" args="16">mat</e>
    <e type="operand" style="unit">K</e>
    <e type="operator" args="2">*</e>
    <e type="operator" args="2">:</e>
    </input>
  </math>
  </region>
