  <region left="18" top="9" width="455" height="24" color="#000000" fontSize="10">
  <text lang="eng" fontFamily="DejaVu Sans" fontSize="10">
    <content>
    <p bold="true">IAPWS-IF97 High-Precision Steam Tables &amp; Thermodynamic Properties</p>
    </content>
  </text>
  </region>
  <region left="18" top="45" width="70" height="24" color="#000000" fontSize="10">
