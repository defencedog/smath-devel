    <e type="operand">273.15</e>
    <e type="operand" style="unit">K</e>
    <e type="operator" args="2">*</e>
    <e type="operator" args="2">-</e>
    <e type="function" args="1">vectorize</e>
    <e type="operator" args="2">:</e>
    </input>
  </math>
  </region>
  <region left="18" top="2526" width="60" height="24" color="#000000" fontSize="10">
  <math>
    <description active="true" position="Top" lang="eng">
      <content>
        <p>Vapor pressure curve coordinates (T [°C], Psat [bar]) for 2D XY plot</p>
      </content>
    </description>
    <input>
    <e type="operand">xy_psat_curve</e>
    <e type="operand">T_sat_C</e>
    <e type="operand">P_sat_bar</e>
    <e type="function" args="2">augment</e>
    <e type="operator" args="2">:</e>
    </input>
  </math>
  </region>
  <region left="18" top="2590" width="330" height="250" color="#000000" fontSize="10">
  <xyplot width="330" height="250" points="100" smoothing="true">
    <propertiessource index="1" sourcetype="PropertyGrid" />
    <grid gridcolor="LightGray" gridpattern="Dash" gridthickness="1" isxgrid="true" isygrid="true" />
    <xaxes xmin="0.0" xmax="380.0" xtick="50.0" decimalplaces="3" numberformat="General" />
    <yaxes ymin="0.0" ymax="225.0" ytick="25.0" decimalplaces="3" numberformat="General" />
    <y2axes isy2axis="false" y2min="-1" y2max="1" y2tick="0.5" decimalplaces="3" numberformat="General" />
    <title2d title="Water-Steam Vapor Pressure Curve Psat(T)" titlefont="DejaVu Sans, 10pt" titlefontcolor="Black" />
    <xylabel labelfont="DejaVu Sans, 10pt" labelfontcolor="Black" tickfont="DejaVu Sans, 8pt" tickfontcolor="Black" xlabel="Temperature T [°C]" ylabel="Saturation Pressure Psat [bar]" y2label="y2" />
    <legend isbordervisible="true" islegendvisible="true" legendbackcolor="200, 255, 255, 255" legendbordercolor="Black" legendfont="DejaVu Sans, 8pt" legendposition="SouthEast" textcolor="Black" />
    <traces>
