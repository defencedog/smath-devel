          <e type="operand">3.0</e>
          <e type="operand">5.0</e>
          <e type="operand">7.0</e>
          <e type="operand">10.0</e>
          <e type="operand">15.0</e>
          <e type="operand">8</e>
          <e type="operand">1</e>
          <e type="function" args="10">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="12285" width="133" height="154" color="#000000" fontSize="10">
      <math decimalPlaces="4">
