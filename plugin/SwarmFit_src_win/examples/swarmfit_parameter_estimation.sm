          <e type="operand">p_mm</e>
          <e type="function" args="3">swarmfit_predict</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">1.8728</e>
          <e type="operand">3.33</e>
          <e type="operand">5.4504</e>
          <e type="operand">8.8203</e>
          <e type="operand">11.11</e>
          <e type="operand">12.7671</e>
          <e type="operand">13.4351</e>
          <e type="operand">7</e>
          <e type="operand">1</e>
          <e type="function" args="9">mat</e>
        </result>
      </math>
    </region>
    <region left="18" top="2916" width="310" height="25" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Coefficient of determination R^2 for Michaelis-Menten fit</p>
