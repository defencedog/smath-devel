      </content>
        </description>
        <input>
          <e type="operand">p_min_consec</e>
          <e type="operand">0.1</e>
          <e type="operand">0.05</e>
          <e type="operand">2</e>
          <e type="operand">1</e>
          <e type="function" args="4">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
