  </region>
  <region left="18" top="5955" width="60" height="24" color="#000000" fontSize="10">
  <math>
    <description active="true" position="Top" lang="eng">
      <content>
        <p>Augmented matrix of equilibrium adsorption points [C_e, q_e]</p>
      </content>
    </description>
    <input>
    <e type="operand">xy_data_power</e>
    <e type="operand">Ce_data</e>
    <e type="operand">qe_data</e>
    <e type="function" args="2">augment</e>
    <e type="operator" args="2">:</e>
    </input>
  </math>
  </region>
  <region left="18" top="6019" width="60" height="24" color="#000000" fontSize="10">
  <math>
    <description active="true" position="Top" lang="eng">
      <content>
