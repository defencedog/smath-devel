    <e type="operator" args="2">:</e>
    </input>
  </math>
  </region>
  <region left="18" top="6083" width="330" height="250" color="#000000" fontSize="10">
  <xyplot width="330" height="250" points="100" smoothing="true">
    <propertiessource index="1" sourcetype="PropertyGrid" />
    <grid gridcolor="LightGray" gridpattern="Dash" gridthickness="1" isxgrid="true" isygrid="true" />
    <xaxes xmin="0.0" xmax="45.0" xtick="5.0" decimalplaces="3" numberformat="General" />
    <yaxes ymin="0.0" ymax="30.0" ytick="5.0" decimalplaces="3" numberformat="General" />
    <y2axes isy2axis="false" y2min="-1" y2max="1" y2tick="0.5" decimalplaces="3" numberformat="General" />
    <title2d title="Problem 3: Freundlich Adsorption Isotherm Fit (swarmfit_power)" titlefont="DejaVu Sans, 10pt" titlefontcolor="Black" />
    <xylabel labelfont="DejaVu Sans, 10pt" labelfontcolor="Black" tickfont="DejaVu Sans, 8pt" tickfontcolor="Black" xlabel="Equilibrium Concentration C_e [mg/L]" ylabel="Adsorbed Capacity q_e [mg/g]" y2label="y2" />
    <legend isbordervisible="true" islegendvisible="true" legendbackcolor="200, 255, 255, 255" legendbordercolor="Black" legendfont="DejaVu Sans, 8pt" legendposition="SouthEast" textcolor="Black" />
    <traces>
      <trace seriesname="Equilibrium Data (qe_data)" isy2data="false" isvisible="true" plotmethod="Points" linecolor="Purple" linethickness="1" linepattern="Solid" symbolsize="8" symboltype="Circle" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />      <trace seriesname="Fitted Freundlich Isotherm (qe_pred)" isy2data="false" isvisible="true" plotmethod="Lines" linecolor="Crimson" linethickness="1" linepattern="Solid" symbolsize="8" symboltype="None" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />    </traces>
