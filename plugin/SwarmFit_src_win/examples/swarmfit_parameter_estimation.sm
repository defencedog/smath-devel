    <e type="operand">7.3</e>
    <e type="operand">11.2</e>
    <e type="operand">17.1</e>
    <e type="operand">26.2</e>
    <e type="operand">6</e>
    <e type="operand">1</e>
    <e type="function" args="8">mat</e>
    <e type="operator" args="2">:</e>
    </input>
  </math>
  </region>
  <region left="18" top="5369" width="84" height="45" color="#000000" fontSize="10">
  <math>
    <description active="true" position="Top" lang="eng">
