          <e type="operand">21.3</e>
          <e type="operand">34.9</e>
          <e type="operand">51.0</e>
          <e type="operand">53.9</e>
          <e type="operand">48.1</e>
          <e type="operand">35.8</e>
          <e type="operand">21.6</e>
          <e type="operand">8.1</e>
          <e type="operand">8</e>
          <e type="operand">1</e>
          <e type="function" args="10">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
