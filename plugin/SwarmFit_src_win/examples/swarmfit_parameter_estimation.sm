      <xyplot animFrameRate="20" animPlaybackMode="RepeatIndefinitely" width="731" height="314" points="100" name="XYPlot" keepAspectRatio="false">
        <chartstyle usedefault="false" backcolor="White" bordercolor="Black" />
        <grid gridcolor="LightGray" gridpattern="Dash" gridthickness="1" isxgrid="true" isygrid="true" isy2grid="false" />
        <xaxes xmin="9" xmax="81" xtick="20" visible="True" decimalplaces="3" numberformat="General" />
        <yaxes ymin="0" ymax="55" ytick="10" visible="True" decimalplaces="3" numberformat="General" />
        <y2axes isy2axis="false" y2min="-1" y2max="1" y2tick="0.5" visible="True" decimalplaces="3" numberformat="General" />
        <title2d title="Problem 5: Langmuir Monolayer Adsorption Equilibrium (User-Defined f_langmuir)" titlefont="DejaVu Sans, 10pt" titlefontcolor="Black" />
        <xylabel labelfont="DejaVu Sans, 10pt" labelfontcolor="Black" tickfont="DejaVu Sans, 8pt" tickfontcolor="Black" xlabel="Equilibrium Solute Concentration C_e [mg/L]" ylabel="Adsorbed Capacity q_e [mg/g]" y2label="y2" />
