    <region left="18" top="13563" width="743" height="335" color="#000000" fontSize="10">
      <xyplot animFrameRate="20" animPlaybackMode="RepeatIndefinitely" width="733" height="327" points="100" name="XYPlot" keepAspectRatio="false">
        <chartstyle usedefault="false" backcolor="White" bordercolor="Black" />
        <grid gridcolor="LightGray" gridpattern="Dash" gridthickness="1" isxgrid="true" isygrid="true" isy2grid="false" />
        <xaxes xmin="0" xmax="16" xtick="2" visible="True" decimalplaces="3" numberformat="General" />
        <yaxes ymin="0" ymax="65" ytick="10" visible="True" decimalplaces="3" numberformat="General" />
        <y2axes isy2axis="false" y2min="-1" y2max="1" y2tick="0.5" visible="True" decimalplaces="3" numberformat="General" />
        <title2d title="Problem 6: Consecutive Batch Reaction Kinetics A -&gt; B -&gt; C (User-Defined f_consec)" titlefont="DejaVu Sans, 10pt" titlefontcolor="Black" />
        <xylabel labelfont="DejaVu Sans, 10pt" labelfontcolor="Black" tickfont="DejaVu Sans, 8pt" tickfontcolor="Black" xlabel="Reaction Time t [min]" ylabel="Intermediate Concentration C_B [mol/m3]" y2label="y2" />
        <legend isbordervisible="true" islegendvisible="true" legendbackcolor="200, 255, 255, 255" legendbordercolor="Black" legendfont="DejaVu Sans, 8pt" legendposition="SouthEast" textcolor="Black" />
        <traces>
          <trace seriesname="Measured Intermediate (CB_data)" isy2data="false" isvisible="true" plotmethod="Lines" lineantialias="true" linecolor="Black" linethickness="1" linepattern="Solid" fillmode="Auto" filltotrace="-1" filled="false" hatched="false" fillcolor="64, 0, 0, 255" hatchstyle="Percent20" symbolantialias="true" symbolsize="8" symboltype="Circle" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />
          <trace seriesname="Fitted Kinetic Trajectory (CB_pred)" isy2data="false" isvisible="true" plotmethod="Lines" lineantialias="true" linecolor="MediumBlue" linethickness="1" linepattern="Solid" fillmode="Auto" filltotrace="-1" filled="false" hatched="false" fillcolor="64, 0, 0, 255" hatchstyle="Percent20" symbolantialias="true" symbolsize="8" symboltype="None" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />
        </traces>
        <input>
          <e type="operand">xy_data_consec</e>
          <e type="operand">xy_fit_consec</e>
          <e type="operand">2</e>
          <e type="operand">1</e>
          <e type="function" args="4">sys</e>
        </input>
      </xyplot>
    </region>
    <region left="18" top="13968" width="752" height="86" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="DejaVu Sans" fontSize="10">
        <content>
    <p bold="true">Problem 7: Analytical Instrumentation Baseline Calibration (swarmfit_linear)</p>
    <p bold="true">Model Formulation: Y = a * X + b</p>
    <p bold="true">Spectrophotometric standard curve regression with automated bounding and initialization via swarmfit_linear.</p>
    </content>
      </text>
    </region>
    <region left="18" top="14067" width="109" height="118" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Analytical standard concentration data vector X [mg/L]</p>
      </content>
        </description>
        <input>
          <e type="operand">x_lin</e>
          <e type="operand">1.0</e>
          <e type="operand">2.0</e>
          <e type="operand">3.0</e>
          <e type="operand">4.0</e>
          <e type="operand">5.0</e>
          <e type="operand">6.0</e>
          <e type="operand">6</e>
          <e type="operand">1</e>
          <e type="function" args="8">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="14220" width="117" height="118" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Measured spectrophotometer instrument response vector Y [mV]</p>
      </content>
        </description>
        <input>
          <e type="operand">y_lin</e>
          <e type="operand">3.2</e>
          <e type="operand">5.1</e>
          <e type="operand">7.0</e>
          <e type="operand">8.9</e>
          <e type="operand">10.8</e>
          <e type="operand">12.7</e>
          <e type="operand">6</e>
          <e type="operand">1</e>
          <e type="function" args="8">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="14382" width="357" height="45" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Fitted linear calibration parameters [slope a; intercept b] via swarmfit_linear</p>
      </content>
        </description>
        <input>
          <e type="operand">p_lin</e>
          <e type="operand">x_lin</e>
          <e type="operand">y_lin</e>
          <e type="function" args="2">swarmfit_linear</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">1.9</e>
          <e type="operand">1.3</e>
          <e type="operand">2</e>
          <e type="operand">1</e>
          <e type="function" args="4">mat</e>
        </result>
      </math>
    </region>
    <region left="18" top="14445" width="139" height="33" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Fitted calibration sensitivity slope a [mV/(mg/L)]</p>
      </content>
        </description>
        <input>
          <e type="operand">slope_a</e>
          <e type="operand">p_lin</e>
          <e type="operand">1</e>
          <e type="function" args="2">el</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="14508" width="171" height="33" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Fitted instrument baseline intercept b [mV]</p>
      </content>
        </description>
        <input>
          <e type="operand">intercept_b</e>
          <e type="operand">p_lin</e>
          <e type="operand">2</e>
          <e type="function" args="2">el</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="14571" width="489" height="118" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Predicted calibration response vector evaluated via native "linear" model</p>
      </content>
        </description>
        <input>
          <e type="operand">y_lin_pred</e>
          <e type="operand">x_lin</e>
          <e type="operand" style="string">linear</e>
          <e type="operand">p_lin</e>
          <e type="function" args="3">swarmfit_predict</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">3.2</e>
          <e type="operand">5.1</e>
          <e type="operand">7</e>
          <e type="operand">8.9</e>
          <e type="operand">10.8</e>
          <e type="operand">12.7</e>
          <e type="operand">6</e>
          <e type="operand">1</e>
          <e type="function" args="8">mat</e>
        </result>
      </math>
    </region>
    <region left="18" top="14715" width="342" height="25" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Coefficient of determination R^2 for linear calibration baseline</p>
      </content>
        </description>
        <input>
          <e type="operand">R2_lin</e>
          <e type="operand">y_lin</e>
          <e type="operand">y_lin_pred</e>
          <e type="function" args="2">swarmfit_r2</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">1</e>
        </result>
      </math>
    </region>
    <region left="18" top="14778" width="285" height="25" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Augmented matrix of calibration standards [X, Y]</p>
      </content>
        </description>
        <input>
          <e type="operand">xy_data_lin</e>
          <e type="operand">x_lin</e>
          <e type="operand">y_lin</e>
          <e type="function" args="2">augment</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="14850" width="317" height="25" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Augmented matrix of fitted linear baseline [X, y_lin_pred]</p>
      </content>
        </description>
        <input>
          <e type="operand">xy_fit_lin</e>
          <e type="operand">x_lin</e>
          <e type="operand">y_lin_pred</e>
          <e type="function" args="2">augment</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="14976" width="742" height="333" color="#000000" fontSize="10">
      <xyplot animFrameRate="20" animPlaybackMode="RepeatIndefinitely" width="732" height="325" points="100" name="XYPlot" keepAspectRatio="false">
        <chartstyle usedefault="false" backcolor="White" bordercolor="Black" />
        <grid gridcolor="LightGray" gridpattern="Dash" gridthickness="1" isxgrid="true" isygrid="true" isy2grid="false" />
        <xaxes xmin="0" xmax="7" xtick="1" visible="True" decimalplaces="3" numberformat="General" />
        <yaxes ymin="0" ymax="15" ytick="3" visible="True" decimalplaces="3" numberformat="General" />
        <y2axes isy2axis="false" y2min="-1" y2max="1" y2tick="0.5" visible="True" decimalplaces="3" numberformat="General" />
        <title2d title="Problem 7: Linear Calibration Baseline Regression (swarmfit_linear)" titlefont="DejaVu Sans, 10pt" titlefontcolor="Black" />
        <xylabel labelfont="DejaVu Sans, 10pt" labelfontcolor="Black" tickfont="DejaVu Sans, 8pt" tickfontcolor="Black" xlabel="Standard Concentration X [mg/L]" ylabel="Instrument Response Y [mV]" y2label="y2" />
        <legend isbordervisible="true" islegendvisible="true" legendbackcolor="200, 255, 255, 255" legendbordercolor="Black" legendfont="DejaVu Sans, 8pt" legendposition="SouthEast" textcolor="Black" />
        <traces>
          <trace seriesname="Calibration Data (y_lin)" isy2data="false" isvisible="true" plotmethod="Lines" lineantialias="true" linecolor="Teal" linethickness="1" linepattern="Solid" fillmode="Auto" filltotrace="-1" filled="false" hatched="false" fillcolor="64, 0, 0, 255" hatchstyle="Percent20" symbolantialias="true" symbolsize="8" symboltype="Circle" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />
          <trace seriesname="Fitted Linear Baseline (y_lin_pred)" isy2data="false" isvisible="true" plotmethod="Lines" lineantialias="true" linecolor="DarkRed" linethickness="1" linepattern="Solid" fillmode="Auto" filltotrace="-1" filled="false" hatched="false" fillcolor="64, 0, 0, 255" hatchstyle="Percent20" symbolantialias="true" symbolsize="8" symboltype="None" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />
        </traces>
        <input>
          <e type="operand">xy_data_lin</e>
          <e type="operand">xy_fit_lin</e>
          <e type="operand">2</e>
          <e type="operand">1</e>
          <e type="function" args="4">sys</e>
        </input>
      </xyplot>
    </region>
    <region left="18" top="15354" width="768" height="429" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="DejaVu Sans" fontSize="10">
        <content>
          <p>=================================================================</p>
          <p>SwarmFit Chemical &amp; Process Engineering Verification Summary:</p>
          <p>  1. Built-in Native Model (Michaelis-Menten Kinetics, "mm"): R2_mm &gt; 0.999 + visual fit plot</p>
          <p>  2. Built-in Exponential Relaxation (CSTR Tracer Washout, swarmfit_expdecay): R2_decay &gt; 0.999 + visual fit plot</p>
          <p>  3. Built-in Power Law Isotherm (Freundlich Adsorption, swarmfit_power): R2_power &gt; 0.998 + visual fit plot</p>
          <p>  4. User-Defined SMath Function (Haldane Substrate Inhibition, f_haldane): R2_haldane &gt; 0.998 + visual fit plot + '=' cached</p>
          <p>  5. User-Defined SMath Function (Langmuir Monolayer Adsorption, f_langmuir): R2_lang &gt; 0.998 + visual fit plot + '=' cached</p>
          <p>  6. User-Defined SMath Function (Consecutive Batch Kinetics A-&gt;B-&gt;C, f_consec): R2_consec &gt; 0.998 + visual fit plot + '=' cached</p>
          <p>  7. Fast Analytical Linear Baseline (Spectrophotometry, swarmfit_linear): R2_lin &gt; 0.999 + visual fit plot</p>
          <p>  8. Numerical diagnostics verified (SSE, RMSE, MaxResidual, Iterations, Improvements)</p>
          <p>  9. All variables carry descriptive engineering hover notes and tooltips</p>
          <p>================================================================</p>
        </content>
      </text>
    </region>
  </regions>
</worksheet>