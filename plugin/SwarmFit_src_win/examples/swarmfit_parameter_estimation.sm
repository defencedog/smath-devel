          <e type="operand">1</e>
          <e type="function" args="4">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="12654" width="743" height="45" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Fitted rate constants [k_1; k_2] via global PSO and user-defined f_consec</p>
      </content>
        </description>
        <input>
          <e type="operand">p_consec</e>
          <e type="operand">t_consec</e>
          <e type="operand">CB_data</e>
