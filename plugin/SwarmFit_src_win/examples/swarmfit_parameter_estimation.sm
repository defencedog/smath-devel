    <yaxes ymin="0.0" ymax="55.0" ytick="10.0" decimalplaces="3" numberformat="General" />
    <y2axes isy2axis="false" y2min="-1" y2max="1" y2tick="0.5" decimalplaces="3" numberformat="General" />
    <title2d title="Problem 5: Langmuir Monolayer Adsorption Equilibrium (User-Defined f_langmuir)" titlefont="DejaVu Sans, 10pt" titlefontcolor="Black" />
    <xylabel labelfont="DejaVu Sans, 10pt" labelfontcolor="Black" tickfont="DejaVu Sans, 8pt" tickfontcolor="Black" xlabel="Equilibrium Solute Concentration C_e [mg/L]" ylabel="Adsorbed Capacity q_e [mg/g]" y2label="y2" />
    <legend isbordervisible="true" islegendvisible="true" legendbackcolor="200, 255, 255, 255" legendbordercolor="Black" legendfont="DejaVu Sans, 8pt" legendposition="SouthEast" textcolor="Black" />
    <traces>
      <trace seriesname="Adsorption Data (qe_lang)" isy2data="false" isvisible="true" plotmethod="Points" linecolor="DarkSlateGray" linethickness="1" linepattern="Solid" symbolsize="8" symboltype="Circle" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />      <trace seriesname="Fitted Langmuir Isotherm (qe_pred_lang)" isy2data="false" isvisible="true" plotmethod="Lines" linecolor="Teal" linethickness="1" linepattern="Solid" symbolsize="8" symboltype="None" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />    </traces>
    <input>
      <e type="operand">xy_data_lang</e>
      <e type="operand">xy_fit_lang</e>
      <e type="operand">2</e>
