    </region>
    <region left="18" top="12717" width="155" height="33" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Fitted primary reaction rate constant k_1 [min^-1]</p>
      </content>
        </description>
        <input>
          <e type="operand">k1_fit</e>
          <e type="operand">p_consec</e>
          <e type="operand">1</e>
