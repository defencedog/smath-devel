    <e type="function" args="4">swarmfit_power</e>
    <e type="operator" args="2">:</e>
    </input>
  </math>
  </region>
  <region left="18" top="5603" width="60" height="24" color="#000000" fontSize="10">
  <math>
    <description active="true" position="Top" lang="eng">
      <content>
        <p>Fitted Freundlich capacity factor K_F [(mg/g)*(L/mg)^(1/n)]</p>
