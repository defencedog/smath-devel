  <region left="18" top="3065" width="330" height="250" color="#000000" fontSize="10">
  <xyplot width="330" height="250" points="100" smoothing="true">
    <propertiessource index="1" sourcetype="PropertyGrid" />
    <grid gridcolor="LightGray" gridpattern="Dash" gridthickness="1" isxgrid="true" isygrid="true" />
    <xaxes xmin="0.0" xmax="35.0" xtick="5.0" decimalplaces="3" numberformat="General" />
    <yaxes ymin="0.0" ymax="16.0" ytick="2.0" decimalplaces="3" numberformat="General" />
    <y2axes isy2axis="false" y2min="-1" y2max="1" y2tick="0.5" decimalplaces="3" numberformat="General" />
    <title2d title="Problem 1: Michaelis-Menten Enzyme Kinetics Fit (Native &quot;mm&quot; Model)" titlefont="DejaVu Sans, 10pt" titlefontcolor="Black" />
    <xylabel labelfont="DejaVu Sans, 10pt" labelfontcolor="Black" tickfont="DejaVu Sans, 8pt" tickfontcolor="Black" xlabel="Substrate Concentration S [mM]" ylabel="Reaction Velocity v [µmol/(L·min)]" y2label="y2" />
    <legend isbordervisible="true" islegendvisible="true" legendbackcolor="200, 255, 255, 255" legendbordercolor="Black" legendfont="DejaVu Sans, 8pt" legendposition="SouthEast" textcolor="Black" />
    <traces>
      <trace seriesname="Experimental Data (v_data)" isy2data="false" isvisible="true" plotmethod="Points" linecolor="Blue" linethickness="1" linepattern="Solid" symbolsize="8" symboltype="Circle" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />      <trace seriesname="Fitted Michaelis-Menten (v_pred)" isy2data="false" isvisible="true" plotmethod="Lines" linecolor="Red" linethickness="1" linepattern="Solid" symbolsize="8" symboltype="None" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />    </traces>
    <input>
      <e type="operand">xy_data_mm</e>
      <e type="operand">xy_fit_mm</e>
      <e type="operand">2</e>
      <e type="operand">1</e>
      <e type="function" args="4" preserve="true">sys</e>
    </input>
  </xyplot>
  </region>
  <region left="18" top="3410" width="500" height="104" color="#000000" fontSize="10">
  <text lang="eng" fontFamily="DejaVu Sans" fontSize="10">
    <content>
    <p bold="true">Problem 2: First-Order Reaction Relaxation / CSTR Tracer Washout (Exponential Decay)</p>
    <p bold="true">Model Formulation: C(t) = C_0 * exp(-t / tau)</p>
    <p bold="true">where C_0 is initial tracer concentration [mg/L] and tau is hydrodynamic residence time [s].</p>
    <p bold="true">Fitted using the dedicated convenience function swarmfit_expdecay.</p>
    </content>
  </text>
  </region>
  <region left="18" top="3526" width="156" height="153" color="#000000" fontSize="10">
  <math>
    <description active="true" position="Top" lang="eng">
      <content>
        <p>Elapsed washout time measurement points t [s]</p>
      </content>
    </description>
    <input>
    <e type="operand">t_data</e>
    <e type="operand">0.0</e>
    <e type="operand">2.0</e>
    <e type="operand">4.0</e>
    <e type="operand">6.0</e>
    <e type="operand">8.0</e>
    <e type="operand">10.0</e>
    <e type="operand">15.0</e>
    <e type="operand">20.0</e>
    <e type="operand">8</e>
    <e type="operand">1</e>
    <e type="function" args="10">mat</e>
    <e type="operator" args="2">:</e>
    </input>
  </math>
  </region>
