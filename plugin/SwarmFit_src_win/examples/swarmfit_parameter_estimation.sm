    <e type="operator" args="2">:</e>
    </input>
  </math>
  </region>
  <region left="18" top="5811" width="72" height="24" color="#000000" fontSize="10">
  <math>
    <description active="true" position="Top" lang="eng">
      <content>
        <p>Model predicted adsorption capacity vector qe_pred evaluated via native &quot;power&quot; model</p>
