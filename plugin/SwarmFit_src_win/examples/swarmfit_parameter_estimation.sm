    <region left="18" top="3537" width="742" height="337" color="#000000" fontSize="10">
      <xyplot animFrameRate="20" animPlaybackMode="RepeatIndefinitely" width="732" height="329" points="100" name="XYPlot" keepAspectRatio="false">
        <chartstyle usedefault="false" backcolor="White" bordercolor="Black" />
        <grid gridcolor="LightGray" gridpattern="Dash" gridthickness="1" isxgrid="true" isygrid="true" isy2grid="false" />
        <xaxes xmin="0" xmax="35" xtick="5" visible="True" decimalplaces="3" numberformat="General" />
        <yaxes ymin="0" ymax="16" ytick="2" visible="True" decimalplaces="3" numberformat="General" />
        <y2axes isy2axis="false" y2min="-1" y2max="1" y2tick="0.5" visible="True" decimalplaces="3" numberformat="General" />
        <title2d title="Problem 1: Michaelis-Menten Enzyme Kinetics Fit (Native &quot;mm&quot; Model)" titlefont="DejaVu Sans, 10pt" titlefontcolor="Black" />
        <xylabel labelfont="DejaVu Sans, 10pt" labelfontcolor="Black" tickfont="DejaVu Sans, 8pt" tickfontcolor="Black" xlabel="Substrate Concentration S [mM]" ylabel="Reaction Velocity v [µmol/(L·min)]" y2label="y2" />
        <legend isbordervisible="true" islegendvisible="true" legendbackcolor="200, 255, 255, 255" legendbordercolor="Black" legendfont="DejaVu Sans, 8pt" legendposition="SouthEast" textcolor="Black" />
        <traces>
          <trace seriesname="Experimental Data (v_data)" isy2data="false" isvisible="true" plotmethod="Lines" lineantialias="true" linecolor="Blue" linethickness="1" linepattern="Solid" fillmode="Auto" filltotrace="-1" filled="false" hatched="false" fillcolor="64, 0, 0, 255" hatchstyle="Percent20" symbolantialias="true" symbolsize="8" symboltype="Circle" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />
          <trace seriesname="Fitted Michaelis-Menten (v_pred)" isy2data="false" isvisible="true" plotmethod="Lines" lineantialias="true" linecolor="Red" linethickness="1" linepattern="Solid" fillmode="Auto" filltotrace="-1" filled="false" hatched="false" fillcolor="64, 0, 0, 255" hatchstyle="Percent20" symbolantialias="true" symbolsize="8" symboltype="None" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />
        </traces>
        <input>
          <e type="operand">xy_data_mm</e>
          <e type="operand">xy_fit_mm</e>
          <e type="operand">2</e>
          <e type="operand">1</e>
          <e type="function" args="4">sys</e>
        </input>
      </xyplot>
    </region>
    <region left="18" top="4005" width="628" height="117" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="DejaVu Sans" fontSize="10">
        <content>
    <p bold="true">Problem 2: First-Order Reaction Relaxation / CSTR Tracer Washout (Exponential Decay)</p>
    <p bold="true">Model Formulation: C(t) = C_0 * exp(-t / tau)</p>
    <p bold="true">where C_0 is initial tracer concentration [mg/L] and tau is hydrodynamic residence time [s].</p>
    <p bold="true">Fitted using the dedicated convenience function swarmfit_expdecay.</p>
    </content>
      </text>
    </region>
    <region left="18" top="4122" width="125" height="154" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Elapsed washout time measurement points t [s]</p>
      </content>
        </description>
        <input>
          <e type="operand">t_data</e>
          <e type="operand">0.0</e>
          <e type="operand">2.0</e>
          <e type="operand">4.0</e>
          <e type="operand">6.0</e>
          <e type="operand">8.0</e>
          <e type="operand">10.0</e>
          <e type="operand">15.0</e>
          <e type="operand">20.0</e>
          <e type="operand">8</e>
          <e type="operand">1</e>
          <e type="function" args="10">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="4311" width="133" height="154" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Observed tracer concentration data vector C [mg/L]</p>
      </content>
        </description>
        <input>
          <e type="operand">C_data</e>
          <e type="operand">100.0</e>
          <e type="operand">67.0</e>
          <e type="operand">44.9</e>
          <e type="operand">30.1</e>
          <e type="operand">20.2</e>
          <e type="operand">13.5</e>
          <e type="operand">5.0</e>
          <e type="operand">1.8</e>
          <e type="operand">8</e>
          <e type="operand">1</e>
          <e type="function" args="10">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="4509" width="165" height="45" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Lower search bounds for tracer washout [C0_min; tau_min]</p>
      </content>
        </description>
        <input>
          <e type="operand">p_min_decay</e>
          <e type="operand">50.0</e>
          <e type="operand">1.0</e>
          <e type="operand">2</e>
          <e type="operand">1</e>
          <e type="function" args="4">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="4590" width="173" height="45" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Upper search bounds for tracer washout [C0_max; tau_max]</p>
      </content>
        </description>
        <input>
          <e type="operand">p_max_decay</e>
          <e type="operand">150.0</e>
          <e type="operand">15.0</e>
          <e type="operand">2</e>
          <e type="operand">1</e>
          <e type="function" args="4">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="4680" width="633" height="45" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Fitted relaxation parameters [C_0; tau] via swarmfit_expdecay</p>
      </content>
        </description>
        <input>
          <e type="operand">p_decay</e>
          <e type="operand">t_data</e>
          <e type="operand">C_data</e>
          <e type="operand">p_min_decay</e>
          <e type="operand">p_max_decay</e>
          <e type="function" args="4">swarmfit_expdecay</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">100</e>
          <e type="operand">4.9954</e>
          <e type="operand">2</e>
          <e type="operand">1</e>
          <e type="function" args="4">mat</e>
        </result>
      </math>
    </region>
    <region left="18" top="4743" width="123" height="33" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Fitted initial tracer concentration C_0 [mg/L]</p>
      </content>
        </description>
        <input>
          <e type="operand">C_0</e>
          <e type="operand">p_decay</e>
          <e type="operand">1</e>
          <e type="function" args="2">el</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="4806" width="123" height="33" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Fitted reactor hydrodynamic residence time tau [s]</p>
      </content>
        </description>
        <input>
          <e type="operand">tau</e>
          <e type="operand">p_decay</e>
          <e type="operand">2</e>
          <e type="function" args="2">el</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="4869" width="216" height="25" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Calculated tracer half-life t_half = tau * ln(2) [s]</p>
      </content>
        </description>
        <input>
          <e type="operand">t_half</e>
          <e type="operand">tau</e>
          <e type="operand">2</e>
          <e type="function" args="1">ln</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">3.4626</e>
        </result>
      </math>
    </region>
    <region left="18" top="5013" width="521" height="154" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Predicted tracer concentration vector C_pred evaluated via native "expdecay" model</p>
      </content>
        </description>
        <input>
          <e type="operand">C_pred</e>
          <e type="operand">t_data</e>
          <e type="operand" style="string">expdecay</e>
          <e type="operand">p_decay</e>
          <e type="function" args="3">swarmfit_predict</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">100</e>
          <e type="operand">67.0075</e>
          <e type="operand">44.9</e>
          <e type="operand">30.0864</e>
          <e type="operand">20.1601</e>
          <e type="operand">13.5088</e>
          <e type="operand">4.9651</e>
          <e type="operand">1.8249</e>
          <e type="operand">8</e>
          <e type="operand">1</e>
          <e type="function" args="10">mat</e>
        </result>
      </math>
    </region>
    <region left="18" top="5184" width="334" height="25" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Coefficient of determination R^2 for tracer washout decay</p>
      </content>
        </description>
        <input>
          <e type="operand">R2_decay</e>
          <e type="operand">C_data</e>
          <e type="operand">C_pred</e>
          <e type="function" args="2">swarmfit_r2</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">1</e>
        </result>
      </math>
    </region>
    <region left="18" top="5247" width="317" height="25" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Augmented matrix of tracer observations [t, C]</p>
      </content>
        </description>
        <input>
          <e type="operand">xy_data_decay</e>
          <e type="operand">t_data</e>
          <e type="operand">C_data</e>
          <e type="function" args="2">augment</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="5310" width="309" height="25" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Augmented matrix of fitted decay curve [t, C_pred]</p>
      </content>
        </description>
        <input>
          <e type="operand">xy_fit_decay</e>
          <e type="operand">t_data</e>
          <e type="operand">C_pred</e>
          <e type="function" args="2">augment</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="5373" width="745" height="354" color="#000000" fontSize="10">
      <xyplot animFrameRate="20" animPlaybackMode="RepeatIndefinitely" width="735" height="346" points="100" name="XYPlot" keepAspectRatio="false">
        <chartstyle usedefault="false" backcolor="White" bordercolor="Black" />
        <grid gridcolor="LightGray" gridpattern="Dash" gridthickness="1" isxgrid="true" isygrid="true" isy2grid="false" />
        <xaxes xmin="-4.84" xmax="26.84" xtick="4" visible="True" decimalplaces="3" numberformat="General" />
        <yaxes ymin="-24.2" ymax="134.2" ytick="40" visible="True" decimalplaces="3" numberformat="General" />
        <y2axes isy2axis="false" y2min="-1" y2max="1" y2tick="0.5" visible="True" decimalplaces="3" numberformat="General" />
        <title2d title="Problem 2: First-Order Reaction Relaxation / Tracer Washout (swarmfit_expdecay)" titlefont="DejaVu Sans, 10pt" titlefontcolor="Black" />
        <xylabel labelfont="DejaVu Sans, 10pt" labelfontcolor="Black" tickfont="DejaVu Sans, 8pt" tickfontcolor="Black" xlabel="Washout Time t [s]" ylabel="Tracer Concentration C(t) [mg/L]" y2label="y2" />
        <legend isbordervisible="true" islegendvisible="true" legendbackcolor="200, 255, 255, 255" legendbordercolor="Black" legendfont="DejaVu Sans, 8pt" legendposition="NorthEast" textcolor="Black" />
        <traces>
          <trace seriesname="Observed Tracer (C_data)" isy2data="false" isvisible="true" plotmethod="Lines" lineantialias="true" linecolor="DarkGreen" linethickness="1" linepattern="Solid" fillmode="Auto" filltotrace="-1" filled="false" hatched="false" fillcolor="64, 0, 0, 255" hatchstyle="Percent20" symbolantialias="true" symbolsize="8" symboltype="Circle" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />
          <trace seriesname="Fitted Exponential Decay (C_pred)" isy2data="false" isvisible="true" plotmethod="Lines" lineantialias="true" linecolor="DarkOrange" linethickness="1" linepattern="Solid" fillmode="Auto" filltotrace="-1" filled="false" hatched="false" fillcolor="64, 0, 0, 255" hatchstyle="Percent20" symbolantialias="true" symbolsize="8" symboltype="None" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />
        </traces>
        <input>
          <e type="operand">xy_data_decay</e>
          <e type="operand">xy_fit_decay</e>
          <e type="operand">2</e>
          <e type="operand">1</e>
          <e type="function" args="4">sys</e>
        </input>
      </xyplot>
    </region>
    <region left="18" top="6012" width="689" height="117" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="DejaVu Sans" fontSize="10">
        <content>
    <p bold="true">Problem 3: Adsorption Equilibrium Isotherm (Freundlich Power Law)</p>
    <p bold="true">Model Formulation: q_e = K_F * C_e^(1/n)</p>
    <p bold="true">Mapped to power-law form Y = a * X^b, where a = K_F [adsorption capacity] and b = 1/n [intensity].</p>
    <p bold="true">Fitted using the dedicated convenience function swarmfit_power.</p>
    </content>
      </text>
    </region>
    <region left="18" top="6138" width="133" height="118" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Equilibrium solute concentration data vector C_e [mg/L]</p>
      </content>
        </description>
        <input>
          <e type="operand">Ce_data</e>
          <e type="operand">1.0</e>
          <e type="operand">2.5</e>
          <e type="operand">5.0</e>
          <e type="operand">10.0</e>
          <e type="operand">20.0</e>
          <e type="operand">40.0</e>
          <e type="operand">6</e>
          <e type="operand">1</e>
          <e type="function" args="8">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="6291" width="133" height="118" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Observed equilibrium adsorption capacity data vector q_e [mg/g]</p>
      </content>
        </description>
        <input>
          <e type="operand">qe_data</e>
          <e type="operand">2.8</e>
          <e type="operand">4.8</e>
          <e type="operand">7.3</e>
          <e type="operand">11.2</e>
          <e type="operand">17.1</e>
          <e type="operand">26.2</e>
          <e type="operand">6</e>
          <e type="operand">1</e>
          <e type="function" args="8">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="6453" width="157" height="45" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Lower search bounds for Freundlich isotherm [K_F_min; (1/n)_min]</p>
      </content>
        </description>
        <input>
          <e type="operand">p_min_power</e>
          <e type="operand">0.5</e>
          <e type="operand">0.1</e>
          <e type="operand">2</e>
          <e type="operand">1</e>
          <e type="function" args="4">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="6534" width="165" height="45" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Upper search bounds for Freundlich isotherm [K_F_max; (1/n)_max]</p>
      </content>
        </description>
        <input>
          <e type="operand">p_max_power</e>
          <e type="operand">10.0</e>
          <e type="operand">1.5</e>
          <e type="operand">2</e>
          <e type="operand">1</e>
          <e type="function" args="4">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="6615" width="625" height="45" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Fitted Freundlich power law parameters [K_F; 1/n] via swarmfit_power</p>
      </content>
        </description>
        <input>
          <e type="operand">p_power</e>
          <e type="operand">Ce_data</e>
          <e type="operand">qe_data</e>
          <e type="operand">p_min_power</e>
          <e type="operand">p_max_power</e>
          <e type="function" args="4">swarmfit_power</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">2.7301</e>
          <e type="operand">0.613</e>
          <e type="operand">2</e>
          <e type="operand">1</e>
          <e type="function" args="4">mat</e>
        </result>
      </math>
    </region>
    <region left="18" top="6687" width="123" height="33" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Fitted Freundlich capacity factor K_F [(mg/g)*(L/mg)^(1/n)]</p>
      </content>
        </description>
        <input>
          <e type="operand">K_F</e>
          <e type="operand">p_power</e>
          <e type="operand">1</e>
          <e type="function" args="2">el</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="6750" width="139" height="33" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Fitted Freundlich adsorption intensity parameter 1/n [dimensionless]</p>
      </content>
        </description>
        <input>
          <e type="operand">inv_n</e>
          <e type="operand">p_power</e>
          <e type="operand">2</e>
          <e type="function" args="2">el</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="6813" width="172" height="41" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Freundlich heterogeneity index n = 1/(1/n) (n &gt; 1 indicates favorable adsorption)</p>
      </content>
        </description>
        <input>
          <e type="operand">n_freundlich</e>
          <e type="operand">1</e>
          <e type="operand">inv_n</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="7011" width="513" height="118" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Model predicted adsorption capacity vector qe_pred evaluated via native "power" model</p>
      </content>
        </description>
        <input>
          <e type="operand">qe_pred</e>
          <e type="operand">Ce_data</e>
          <e type="operand" style="string">power</e>
          <e type="operand">p_power</e>
          <e type="function" args="3">swarmfit_predict</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">2.7301</e>
          <e type="operand">4.7878</e>
          <e type="operand">7.3228</e>
          <e type="operand">11.2</e>
          <e type="operand">17.1301</e>
          <e type="operand">26.2</e>
          <e type="operand">6</e>
          <e type="operand">1</e>
          <e type="function" args="8">mat</e>
        </result>
      </math>
    </region>
    <region left="18" top="7164" width="350" height="25" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Coefficient of determination R^2 for Freundlich isotherm</p>
      </content>
        </description>
        <input>
          <e type="operand">R2_power</e>
          <e type="operand">qe_data</e>
          <e type="operand">qe_pred</e>
          <e type="function" args="2">swarmfit_r2</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">1</e>
        </result>
      </math>
    </region>
    <region left="18" top="7227" width="333" height="25" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Augmented matrix of equilibrium adsorption points [C_e, q_e]</p>
      </content>
        </description>
        <input>
          <e type="operand">xy_data_power</e>
          <e type="operand">Ce_data</e>
          <e type="operand">qe_data</e>
          <e type="function" args="2">augment</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="7290" width="325" height="25" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Augmented matrix of fitted power-law isotherm [C_e, qe_pred]</p>
      </content>
        </description>
        <input>
          <e type="operand">xy_fit_power</e>
          <e type="operand">Ce_data</e>
          <e type="operand">qe_pred</e>
          <e type="function" args="2">augment</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="7353" width="744" height="326" color="#000000" fontSize="10">
      <xyplot animFrameRate="20" animPlaybackMode="RepeatIndefinitely" width="734" height="318" points="100" name="XYPlot" keepAspectRatio="false">
        <chartstyle usedefault="false" backcolor="White" bordercolor="Black" />
        <grid gridcolor="LightGray" gridpattern="Dash" gridthickness="1" isxgrid="true" isygrid="true" isy2grid="false" />
        <xaxes xmin="0" xmax="45" xtick="5" visible="True" decimalplaces="3" numberformat="General" />
        <yaxes ymin="0" ymax="30" ytick="5" visible="True" decimalplaces="3" numberformat="General" />
        <y2axes isy2axis="false" y2min="-1" y2max="1" y2tick="0.5" visible="True" decimalplaces="3" numberformat="General" />
        <title2d title="Problem 3: Freundlich Adsorption Isotherm Fit (swarmfit_power)" titlefont="DejaVu Sans, 10pt" titlefontcolor="Black" />
        <xylabel labelfont="DejaVu Sans, 10pt" labelfontcolor="Black" tickfont="DejaVu Sans, 8pt" tickfontcolor="Black" xlabel="Equilibrium Concentration C_e [mg/L]" ylabel="Adsorbed Capacity q_e [mg/g]" y2label="y2" />
        <legend isbordervisible="true" islegendvisible="true" legendbackcolor="200, 255, 255, 255" legendbordercolor="Black" legendfont="DejaVu Sans, 8pt" legendposition="SouthEast" textcolor="Black" />
        <traces>
          <trace seriesname="Equilibrium Data (qe_data)" isy2data="false" isvisible="true" plotmethod="Lines" lineantialias="true" linecolor="Purple" linethickness="1" linepattern="Solid" fillmode="Auto" filltotrace="-1" filled="false" hatched="false" fillcolor="64, 0, 0, 255" hatchstyle="Percent20" symbolantialias="true" symbolsize="8" symboltype="Circle" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />
          <trace seriesname="Fitted Freundlich Isotherm (qe_pred)" isy2data="false" isvisible="true" plotmethod="Lines" lineantialias="true" linecolor="Crimson" linethickness="1" linepattern="Solid" fillmode="Auto" filltotrace="-1" filled="false" hatched="false" fillcolor="64, 0, 0, 255" hatchstyle="Percent20" symbolantialias="true" symbolsize="8" symboltype="None" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />
        </traces>
        <input>
          <e type="operand">xy_data_power</e>
          <e type="operand">xy_fit_power</e>
          <e type="operand">2</e>
          <e type="operand">1</e>
          <e type="function" args="4">sys</e>
        </input>
      </xyplot>
    </region>
    <region left="18" top="7731" width="647" height="210" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="DejaVu Sans" fontSize="10">
        <content>
    <p bold="true">Problem 4: Substrate Inhibition Kinetics (Andrews/Haldane Bioreactor Model)</p>
    <p bold="true">Model Formulation: v = (V_max * S) / (K_m + S + S^2 / K_i)</p>
    <p bold="true">User defines custom SMath CAS function f_haldane(x, p) directly in the worksheet.</p>
    <p bold="true">Velocity exhibits non-monotonic behavior: reaches a distinct peak at S_opt = sqrt(K_m * K_i)</p>
    <p bold="true">and decreases at higher substrate levels due to biochemical toxicity / substrate inhibition.</p>
    <p bold="true">EVALUATION &amp; CACHING: Model predictions v_pred_inh are evaluated with '=' to cache results</p>
    <p bold="true">in memory and eliminate repetitive symbolic CAS recalculation across sheet repaints.</p>
    </content>
      </text>
    </region>
    <region left="18" top="7965" width="242" height="85" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>User-defined Haldane substrate inhibition rate function v = f(x, [V_max; K_m; K_i])</p>
      </content>
        </description>
        <input>
          <e type="operand">x</e>
          <e type="operand">p</e>
          <e type="function" args="2">f_haldane</e>
          <e type="operand">p</e>
          <e type="operand">1</e>
          <e type="function" args="2">el</e>
          <e type="operand">x</e>
          <e type="operator" args="2">*</e>
          <e type="operand">p</e>
          <e type="operand">2</e>
          <e type="function" args="2">el</e>
          <e type="operand">x</e>
          <e type="operator" args="2">+</e>
          <e type="operand">x</e>
          <e type="operand">2</e>
          <e type="operator" args="2">^</e>
          <e type="operand">p</e>
          <e type="operand">3</e>
          <e type="function" args="2">el</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">+</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="8073" width="117" height="154" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Substrate concentration data vector S [mM] spanning sub-inhibitory to toxic regimes</p>
      </content>
        </description>
        <input>
          <e type="operand">S_inh</e>
          <e type="operand">1.0</e>
          <e type="operand">2.0</e>
          <e type="operand">5.0</e>
          <e type="operand">10.0</e>
          <e type="operand">20.0</e>
          <e type="operand">40.0</e>
          <e type="operand">60.0</e>
          <e type="operand">80.0</e>
          <e type="operand">8</e>
          <e type="operand">1</e>
          <e type="function" args="10">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="8289" width="117" height="154" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Observed reaction velocity vector v [µmol/(L·min)] displaying inhibition peak</p>
      </content>
        </description>
        <input>
          <e type="operand">v_inh</e>
          <e type="operand">3.8</e>
          <e type="operand">6.2</e>
          <e type="operand">9.8</e>
          <e type="operand">11.5</e>
          <e type="operand">10.8</e>
          <e type="operand">8.2</e>
          <e type="operand">6.4</e>
          <e type="operand">5.2</e>
          <e type="operand">8</e>
          <e type="operand">1</e>
          <e type="function" args="10">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="8478" width="133" height="63" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Lower search bounds [V_max_min; K_m_min; K_i_min]</p>
      </content>
        </description>
        <input>
          <e type="operand">p_min_h</e>
          <e type="operand">10.0</e>
          <e type="operand">1.0</e>
          <e type="operand">10.0</e>
          <e type="operand">3</e>
          <e type="operand">1</e>
          <e type="function" args="5">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="8586" width="141" height="63" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Upper search bounds [V_max_max; K_m_max; K_i_max]</p>
      </content>
        </description>
        <input>
          <e type="operand">p_max_h</e>
          <e type="operand">40.0</e>
          <e type="operand">10.0</e>
          <e type="operand">100.0</e>
          <e type="operand">3</e>
          <e type="operand">1</e>
          <e type="function" args="5">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="8685" width="647" height="63" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Fitted parameters [V_max; K_m; K_i] via global PSO and user-defined f_haldane</p>
      </content>
        </description>
        <input>
          <e type="operand">p_haldane</e>
          <e type="operand">S_inh</e>
          <e type="operand">v_inh</e>
          <e type="operand">f_haldane</e>
          <e type="operand">p_min_h</e>
          <e type="operand">p_max_h</e>
          <e type="operand">12</e>
          <e type="operand">60</e>
          <e type="function" args="7">swarmfit</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">20.9485</e>
          <e type="operand">4.6126</e>
          <e type="operand">27.7377</e>
          <e type="operand">3</e>
          <e type="operand">1</e>
          <e type="function" args="5">mat</e>
        </result>
      </math>
    </region>
    <region left="18" top="8784" width="179" height="33" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Fitted maximum theoretical enzymatic velocity V_max [µmol/(L·min)]</p>
      </content>
        </description>
        <input>
          <e type="operand">Vmax_inh</e>
          <e type="operand">p_haldane</e>
          <e type="operand">1</e>
          <e type="function" args="2">el</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="8847" width="163" height="33" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Fitted Michaelis affinity constant K_m [mM]</p>
      </content>
        </description>
        <input>
          <e type="operand">Km_inh</e>
          <e type="operand">p_haldane</e>
          <e type="operand">2</e>
          <e type="function" args="2">el</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="8910" width="163" height="33" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Fitted substrate inhibition constant K_i [mM]</p>
      </content>
        </description>
        <input>
          <e type="operand">Ki_inh</e>
          <e type="operand">p_haldane</e>
          <e type="operand">3</e>
          <e type="function" args="2">el</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="8973" width="265" height="26" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Critical substrate concentration S_opt = sqrt(K_m * K_i) yielding maximum reaction velocity [mM]</p>
      </content>
        </description>
        <input>
          <e type="operand">S_opt</e>
          <e type="operand">Km_inh</e>
          <e type="operand">Ki_inh</e>
          <e type="operator" args="2">*</e>
          <e type="function" args="1">sqrt</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">11.3112</e>
        </result>
      </math>
    </region>
    <region left="18" top="9054" width="555" height="154" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Predicted reaction velocity vector evaluated via user-defined f_haldane (cached with =)</p>
      </content>
        </description>
        <input>
          <e type="operand">v_pred_inh</e>
          <e type="operand">S_inh</e>
          <e type="operand">f_haldane</e>
          <e type="operand">p_haldane</e>
          <e type="function" args="3">swarmfit_predict</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">3.7086</e>
          <e type="operand">6.2007</e>
          <e type="operand">9.9623</e>
          <e type="operand">11.4989</e>
          <e type="operand">10.7336</e>
          <e type="operand">8.1913</e>
          <e type="operand">6.4656</e>
          <e type="operand">5.3144</e>
          <e type="operand">8</e>
          <e type="operand">1</e>
          <e type="function" args="10">mat</e>
        </result>
      </math>
    </region>
    <region left="18" top="9270" width="349" height="25" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Coefficient of determination R^2 for Haldane inhibition fit</p>
      </content>
        </description>
        <input>
          <e type="operand">R2_haldane</e>
          <e type="operand">v_inh</e>
          <e type="operand">v_pred_inh</e>
          <e type="function" args="2">swarmfit_r2</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="9333" width="285" height="25" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Augmented matrix of inhibition data points [S, v]</p>
      </content>
        </description>
        <input>
          <e type="operand">xy_data_inh</e>
          <e type="operand">S_inh</e>
          <e type="operand">v_inh</e>
          <e type="function" args="2">augment</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="9396" width="317" height="25" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Augmented matrix of fitted Haldane inhibition curve [S, v_pred]</p>
      </content>
        </description>
        <input>
          <e type="operand">xy_fit_inh</e>
          <e type="operand">S_inh</e>
          <e type="operand">v_pred_inh</e>
          <e type="function" args="2">augment</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="9459" width="742" height="342" color="#000000" fontSize="10">
      <xyplot animFrameRate="20" animPlaybackMode="RepeatIndefinitely" width="732" height="334" points="100" name="XYPlot" keepAspectRatio="false">
        <chartstyle usedefault="false" backcolor="White" bordercolor="Black" />
        <grid gridcolor="LightGray" gridpattern="Dash" gridthickness="1" isxgrid="true" isygrid="true" isy2grid="false" />
        <xaxes xmin="0" xmax="90" xtick="10" visible="True" decimalplaces="3" numberformat="General" />
        <yaxes ymin="0" ymax="14" ytick="2" visible="True" decimalplaces="3" numberformat="General" />
        <y2axes isy2axis="false" y2min="-1" y2max="1" y2tick="0.5" visible="True" decimalplaces="3" numberformat="General" />
        <title2d title="Problem 4: Substrate Inhibition Kinetics (Andrews/Haldane Bioreactor Model)" titlefont="DejaVu Sans, 10pt" titlefontcolor="Black" />
        <xylabel labelfont="DejaVu Sans, 10pt" labelfontcolor="Black" tickfont="DejaVu Sans, 8pt" tickfontcolor="Black" xlabel="Substrate Concentration S [mM]" ylabel="Reaction Velocity v [µmol/(L·min)]" y2label="y2" />
        <legend isbordervisible="true" islegendvisible="true" legendbackcolor="200, 255, 255, 255" legendbordercolor="Black" legendfont="DejaVu Sans, 8pt" legendposition="NorthEast" textcolor="Black" />
        <traces>
          <trace seriesname="Inhibition Data (v_inh)" isy2data="false" isvisible="true" plotmethod="Lines" lineantialias="true" linecolor="DarkBlue" linethickness="1" linepattern="Solid" fillmode="Auto" filltotrace="-1" filled="false" hatched="false" fillcolor="64, 0, 0, 255" hatchstyle="Percent20" symbolantialias="true" symbolsize="8" symboltype="Circle" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />
          <trace seriesname="Fitted Haldane Model (v_pred_inh)" isy2data="false" isvisible="true" plotmethod="Lines" lineantialias="true" linecolor="Red" linethickness="1" linepattern="Solid" fillmode="Auto" filltotrace="-1" filled="false" hatched="false" fillcolor="64, 0, 0, 255" hatchstyle="Percent20" symbolantialias="true" symbolsize="8" symboltype="None" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />
        </traces>
        <input>
          <e type="operand">xy_data_inh</e>
          <e type="operand">xy_fit_inh</e>
          <e type="operand">2</e>
          <e type="operand">1</e>
          <e type="function" args="4">sys</e>
        </input>
      </xyplot>
    </region>
    <region left="18" top="9846" width="750" height="195" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="DejaVu Sans" fontSize="10">
        <content>
    <p bold="true">Problem 5: Monolayer Wastewater Adsorption Equilibrium (Langmuir Isotherm)</p>
    <p bold="true">Model Formulation: q_e = (q_m * K_L * C_e) / (1 + K_L * C_e)</p>
    <p bold="true">User defines custom SMath CAS function f_langmuir(x, p) for non-linear monolayer adsorption.</p>
    <p bold="true">Parameters: q_m is maximum saturation monolayer capacity [mg/g], K_L is Langmuir affinity constant [L/mg].</p>
    <p bold="true">Computes the dimensionless Hall separation factor R_L = 1 / (1 + K_L * C_e_max) (0 &lt; R_L &lt; 1 indicates favorable adsorption).</p>
    <p bold="true">EVALUATION &amp; CACHING: Model predictions qe_pred_lang are evaluated with '=' to cache results.</p>
    </content>
      </text>
    </region>
    <region left="18" top="10053" width="241" height="59" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>User-defined Langmuir monolayer adsorption isotherm q_e = f(C_e, [q_m; K_L])</p>
      </content>
        </description>
        <input>
          <e type="operand">x</e>
          <e type="operand">p</e>
          <e type="function" args="2">f_langmuir</e>
          <e type="operand">p</e>
          <e type="operand">1</e>
          <e type="function" args="2">el</e>
          <e type="operand">p</e>
          <e type="operand">2</e>
          <e type="function" args="2">el</e>
          <e type="operator" args="2">*</e>
          <e type="operand">x</e>
          <e type="operator" args="2">*</e>
          <e type="operand">1.0</e>
          <e type="operand">p</e>
          <e type="operand">2</e>
          <e type="function" args="2">el</e>
          <e type="operand">x</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">+</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="10143" width="133" height="154" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Equilibrium organic solute concentration data vector C_e [mg/L]</p>
      </content>
        </description>
        <input>
          <e type="operand">Ce_lang</e>
          <e type="operand">1.0</e>
          <e type="operand">2.5</e>
          <e type="operand">5.0</e>
          <e type="operand">10.0</e>
          <e type="operand">20.0</e>
          <e type="operand">40.0</e>
          <e type="operand">60.0</e>
          <e type="operand">80.0</e>
          <e type="operand">8</e>
          <e type="operand">1</e>
          <e type="function" args="10">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="10341" width="141" height="154" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Measured equilibrium adsorbed amount on activated carbon q_e [mg/g]</p>
      </content>
        </description>
        <input>
          <e type="operand">qe_lang</e>
          <e type="operand">6.72</e>
          <e type="operand">13.34</e>
          <e type="operand">21.83</e>
          <e type="operand">29.80</e>
          <e type="operand">38.00</e>
          <e type="operand">42.46</e>
          <e type="operand">45.30</e>
          <e type="operand">45.95</e>
          <e type="operand">8</e>
          <e type="operand">1</e>
          <e type="function" args="10">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="10530" width="157" height="45" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Lower search bounds for Langmuir isotherm [qm_min; KL_min]</p>
      </content>
        </description>
        <input>
          <e type="operand">p_min_lang</e>
          <e type="operand">20.0</e>
          <e type="operand">0.01</e>
          <e type="operand">2</e>
          <e type="operand">1</e>
          <e type="function" args="4">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="10611" width="165" height="45" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Upper search bounds for Langmuir isotherm [qm_max; KL_max]</p>
      </content>
        </description>
        <input>
          <e type="operand">p_max_lang</e>
          <e type="operand">100.0</e>
          <e type="operand">1.0</e>
          <e type="operand">2</e>
          <e type="operand">1</e>
          <e type="function" args="4">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
