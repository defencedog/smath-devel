        </input>
      </math>
    </region>
    <region left="18" top="12960" width="301" height="59" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Optimal batch reaction time t_opt = ln(k1/k2) / (k1 - k2) yielding maximum intermediate concentration [min]</p>
      </content>
        </description>
        <input>
          <e type="operand">t_opt_batch</e>
          <e type="operand">k1_fit</e>
          <e type="operand">k2_fit</e>
          <e type="operator" args="2">/</e>
          <e type="function" args="1">ln</e>
          <e type="operand">k1_fit</e>
          <e type="operand">k2_fit</e>
          <e type="operator" args="2">-</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">3.0246</e>
        </result>
      </math>
    </region>
    <region left="18" top="13068" width="417" height="69" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
