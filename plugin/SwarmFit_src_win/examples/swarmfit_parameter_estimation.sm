          <trace seriesname="Fitted Langmuir Isotherm (qe_pred_lang)" isy2data="false" isvisible="true" plotmethod="Lines" lineantialias="true" linecolor="Teal" linethickness="1" linepattern="Solid" fillmode="Auto" filltotrace="-1" filled="false" hatched="false" fillcolor="64, 0, 0, 255" hatchstyle="Percent20" symbolantialias="true" symbolsize="8" symboltype="None" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />
