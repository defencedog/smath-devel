<?xml version="1.0" encoding="utf-8"?>
<!--
  Mono only. .NET Framework ignores <dllmap>; on Windows the plugin loads the
  bitness-matching engine explicitly by path from its own folder
  (Optim_x86.dll / Optim_x64.dll).

  The two DllImport names come from the engine file names; both map to the one
  Linux library. Without these entries Mono would look for libOptim_x86.so /
  libOptim_x64.so, which do not exist. libOptim.so is the aarch64 build of the
  same optim_shim.cpp, built on Linux with aarch64-linux-gnu-g++ (recipe in
  patches\README.md).
-->
<configuration>
  <dllmap dll="Optim_x86" target="./libOptim.so" os="!windows" />
  <dllmap dll="Optim_x64" target="./libOptim.so" os="!windows" />
</configuration>
