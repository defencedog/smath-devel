    <region left="18" top="2412" width="349" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="DejaVu Sans" fontSize="10">
        <content>
    <p bold="true">3. Local deterministic solvers (bfgs, lbfgs, cg, gd, newton, nm)</p>
    </content>
      </text>
    </region>
    <region left="18" top="2448" width="412" height="109" color="#000000" fontSize="10">
      <math>
        <description active="true" position="Top" lang="eng">
          <content>
        <p>optim_bfgs on Rosenbrock -&gt; (1, 1).</p>
      </content>
        </description>
        <input>
          <e type="operand">o_bfgs</e>
          <e type="operand">f_rosen</e>
          <e type="operand">s_rn</e>
          <e type="function" args="2">optim_bfgs</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">1</e>
          <e type="operand">1</e>
          <e type="operand">5.2641</e>
          <e type="operand">10</e>
