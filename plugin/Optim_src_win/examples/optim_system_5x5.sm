        </traces>
        <input>
          <e type="operand">1</e>
          <e type="operand">2</e>
          <e type="operand">2</e>
          <e type="operand">1</e>
          <e type="function" args="4">mat</e>
          <e type="operand">r5lin</e>
          <e type="operand">6</e>
          <e type="function" args="2">el</e>
          <e type="function" args="1">abs</e>
          <e type="operand">r5nl</e>
          <e type="operand">6</e>
          <e type="function" args="2">el</e>
