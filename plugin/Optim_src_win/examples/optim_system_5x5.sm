      <math>
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Linear start x0 = [0, 0, 0, 0, 0] (used by optim_broyden).</p>
      </content>
        </description>
        <input>
          <e type="operand">s_lin</e>
          <e type="operand">0</e>
          <e type="operand">0</e>
          <e type="operand">0</e>
          <e type="operand">0</e>
          <e type="operand">0</e>
          <e type="operand">5</e>
          <e type="operand">1</e>
          <e type="function" args="7">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="549" width="85" height="100" color="#000000" fontSize="10">
      <math>
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Nonlinear start x0 = [1, 1, 1, 1, 1] (used by optim_lbfgs).</p>
      </content>
        </description>
        <input>
          <e type="operand">s_nl</e>
          <e type="operand">1</e>
          <e type="operand">1</e>
          <e type="operand">1</e>
          <e type="operand">1</e>
          <e type="operand">1</e>
          <e type="operand">5</e>
          <e type="operand">1</e>
          <e type="function" args="7">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="684" width="441" height="53" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="DejaVu Sans" fontSize="10">
        <content>
    <p bold="true">3. Linear 5x5 system - optim_broyden on the residual matrix F(x) = LHS - RHS</p>
    <p bold="true">Expected root [2, -1, 3, 1, -2]; f = max|ri| ~ 0; ok = 1.</p>
    </content>
      </text>
    </region>
