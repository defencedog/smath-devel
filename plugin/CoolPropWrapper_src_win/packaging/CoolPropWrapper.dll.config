<?xml version="1.0" encoding="utf-8"?>
<!--
  Mono only - .NET Framework ignores <dllmap>.

  Every P/Invoke in CoolPropEngine.cs names the engine by bitness
  ("CoolProp_x86" / "CoolProp_x64") because on Windows the two engines must not
  share a file name. On Windows the matching one is preloaded by absolute path
  from this folder first (Windows does not probe a plugin's own directory for
  native dependencies), and the DllImport name then resolves to the loaded
  module. Under Mono both names resolve here to libCoolProp.so, which is
  resolved relative to this assembly - so no explicit load is needed on that
  platform; whichever bitness-suffixed name the dispatcher picks ends at the
  same ELF.
-->
<configuration>
  <dllmap dll="CoolProp_x86" target="libCoolProp.so" os="!windows" />
  <dllmap dll="CoolProp_x64" target="libCoolProp.so" os="!windows" />
</configuration>
