<?xml version="1.0" encoding="utf-8"?>
<!--
  Mono only. .NET Framework ignores <dllmap>; on Windows the plugin loads the
  bitness-matching engine explicitly by path from its own folder
  (IPhreeqc_x86.dll / IPhreeqc_x64.dll).

  The two DllImport names come from the engine file names; both map to the one
  Linux library. Without these entries Mono would look for libIPhreeqc_x86.so /
  libIPhreeqc_x64.so, which do not exist.
-->
<configuration>
  <dllmap dll="IPhreeqc_x86" target="./libIPhreeqc.so" os="!windows" />
  <dllmap dll="IPhreeqc_x64" target="./libIPhreeqc.so" os="!windows" />
</configuration>
