          </content>
        </description>
        <input>
          <e type="operand">1</e>
          <e type="function" args="1">time</e>
          <e type="operand">t.0</e>
          <e type="operator" args="2">-</e>
        </input>
        <result action="numeric">
          <e type="operand">0</e>
        </result>
      </math>
    </region>
    <region left="18" top="1476" width="438" height="114" color="#000000" fontSize="10">
      <math decimalPlaces="4" matrixOptions="0,0,1,5">
        <description active="true" position="Top" lang="eng">
          <content>
            <p>Model predicted pressure trajectory P_pred [bara]</p>
          </content>
        </description>
        <input>
          <e type="operand">P_pred</e>
          <e type="operand">t.vec</e>
          <e type="operand">P.model</e>
          <e type="operand">P.coeff</e>
          <e type="function" args="3">swarmfit_predict</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">1.4628</e>
          <e type="operand">1.6617</e>
          <e type="operand">1.86</e>
          <e type="operand">2.0575</e>
          <e type="operand">2.2544</e>
          <e type="operand">5</e>
          <e type="operand">1</e>
          <e type="function" args="7">mat</e>
        </result>
      </math>
    </region>
    <region left="18" top="1629" width="310" height="30" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
            <p>Coefficient of determination R² for quadratic pressure fit</p>
          </content>
        </description>
        <input>
          <e type="operand">P.r2</e>
          <e type="operand">P.vec</e>
          <e type="operand">P_pred</e>
          <e type="function" args="2">swarmfit_r2</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">0.9945</e>
        </result>
      </math>
    </region>
    <region left="18" top="1701" width="483" height="50" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
            <p>Units added for dimensional consistency P.fit(t) [bara]</p>
          </content>
        </description>
        <input>
          <e type="operand">t.sec</e>
          <e type="function" args="1">P.fit</e>
          <e type="operand">P.coeff</e>
          <e type="operand">1</e>
          <e type="function" args="2">el</e>
          <e type="operand">t.sec</e>
          <e type="operand">2</e>
          <e type="operator" args="2">^</e>
          <e type="operator" args="2">*</e>
          <e type="operand" style="unit">bar</e>
          <e type="operand" style="unit">sec</e>
          <e type="operand">2</e>
          <e type="operator" args="2">^</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">*</e>
          <e type="operand">P.coeff</e>
          <e type="operand">2</e>
          <e type="function" args="2">el</e>
          <e type="operand">t.sec</e>
          <e type="operator" args="2">*</e>
          <e type="operand" style="unit">bar</e>
          <e type="operand" style="unit">sec</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">+</e>
