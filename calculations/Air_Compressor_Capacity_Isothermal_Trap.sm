          <e type="operand">T.vec</e>
          <e type="operand">273.15</e>
          <e type="operator" args="2">-</e>
          <e type="bracket">(</e>
          <e type="function" args="2">augment</e>
          <e type="operand">t.sec</e>
          <e type="function" args="1">T.scalar</e>
          <e type="operand">T.coeff</e>
          <e type="operand">1</e>
          <e type="function" args="2">el</e>
          <e type="operand">T.coeff</e>
          <e type="operand">2</e>
          <e type="function" args="2">el</e>
          <e type="operand">T.coeff</e>
          <e type="operand">3</e>
          <e type="function" args="2">el</e>
          <e type="operand">t.sec</e>
          <e type="operator" args="2">*</e>
          <e type="function" args="1">exp</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">+</e>
          <e type="bracket">(</e>
          <e type="operand">273.15</e>
          <e type="operator" args="2">-</e>
          <e type="operator" args="2">:</e>
          <e type="operand">t.sec</e>
          <e type="function" args="1">P.scalar</e>
          <e type="operand">P.coeff</e>
          <e type="operand">1</e>
          <e type="function" args="2">el</e>
          <e type="operand">t.sec</e>
          <e type="operand">2</e>
          <e type="operator" args="2">^</e>
          <e type="operator" args="2">*</e>
          <e type="operand">P.coeff</e>
          <e type="operand">2</e>
          <e type="function" args="2">el</e>
          <e type="operand">t.sec</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">+</e>
          <e type="operand">P.coeff</e>
          <e type="operand">3</e>
          <e type="function" args="2">el</e>
          <e type="operator" args="2">+</e>
          <e type="operator" args="2">:</e>
          <e type="operand">4</e>
          <e type="operand">1</e>
          <e type="function" args="6">sys</e>
        </input>
