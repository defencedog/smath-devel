    <region left="18" top="3240" width="510" height="27" color="#000000" fontSize="12" isBreakable="false">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-weight: bold; font-size: 12px; font-family: DejaVu Sans;">Mass flow estimation including temperature dynamics </p>
        </content>
      </text>
    </region>
    <region left="18" top="3294" width="721" height="152" color="#000000" fontSize="10">
      <text lang="eng" width="721" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-family: DejaVu Sans;">Differentiating the ideal gas state equation m(t) = V*P(t)/(R*T(t)) yields the instantaneous mass flow:<br />  mdot(t) = (V / R) * [ (1 / T(t)) * (dP/dt) - (P(t) / T(t)²) * (dT/dt) ]<br /><br />Alternative 1 (Direct State Boundary Delta):<br />  m.cumulative_A = (V / R) * [ P.fit(60 s) / T.fit(60 s) - P.fit(0 s) / T.fit(0 s) ]<br /><br />Alternative 2 (Instantaneous Differentiation &amp; Continuous Definite Integration):<br />  m.cumulative_B = int(mdot(t), t, 0, 60 s)<br />  </p>
        </content>
      </text>
    </region>
    <region left="18" top="3456" width="541" height="91" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Alternative 1: Exact thermodynamic boundary state delta M = (V/R)*(P2/T2 - P1/T1)</p>
      </content>
        </description>
        <input>
          <e type="operand">m.cumulative_A_real</e>
          <e type="operand">V.tank</e>
          <e type="operand">R.air</e>
          <e type="operator" args="2">/</e>
          <e type="operand">t.sec</e>
          <e type="function" args="1">P.fit</e>
          <e type="operand">60</e>
          <e type="operand" style="unit">sec</e>
          <e type="operator" args="2">*</e>
          <e type="function" args="2">at</e>
          <e type="operand">t.sec</e>
          <e type="function" args="1">T.fit</e>
          <e type="operand">60</e>
          <e type="operand" style="unit">sec</e>
          <e type="operator" args="2">*</e>
          <e type="function" args="2">at</e>
          <e type="operator" args="2">/</e>
          <e type="operand">t.sec</e>
          <e type="function" args="1">P.fit</e>
          <e type="operand">0</e>
          <e type="operand" style="unit">sec</e>
          <e type="operator" args="2">*</e>
          <e type="function" args="2">at</e>
          <e type="operand">t.sec</e>
          <e type="function" args="1">T.fit</e>
          <e type="operand">0</e>
          <e type="operand" style="unit">sec</e>
          <e type="operator" args="2">*</e>
          <e type="function" args="2">at</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">-</e>
          <e type="bracket">(</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">14.3</e>
          <e type="operand" style="unit">kg</e>
          <e type="operator" args="2">*</e>
        </result>
      </math>
    </region>
    <region left="18" top="3609" width="568" height="219" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
            <p>Alternative 2: Continuous calculus definite integral</p>
          </content>
        </description>
        <input>
          <e type="operand">m.cumulative_B_real</e>
          <e type="operand">dP</e>
          <e type="operand">t.sec</e>
          <e type="function" args="1">P.fit</e>
          <e type="operand">t.sec</e>
          <e type="function" args="2">diff</e>
          <e type="operator" args="2">:</e>
          <e type="operand">dT</e>
          <e type="operand">t.sec</e>
          <e type="function" args="1">T.fit</e>
          <e type="operand">t.sec</e>
          <e type="function" args="2">diff</e>
          <e type="operator" args="2">:</e>
          <e type="operand">mdot</e>
          <e type="operand">V.tank</e>
          <e type="operand">R.air</e>
          <e type="operator" args="2">/</e>
          <e type="operand">1</e>
