    <region left="0" top="1098" width="402" height="24" color="#000000" fontSize="10" isBreakable="false">
      <text lang="eng" fontFamily="DejaVu Sans" fontSize="10">
        <content>
          <p style="font-family: DejaVu Sans;">Section 2: Curve-Fitting &amp; Analytical Calculus of DCS Data</p>
        </content>
      </text>
    </region>
    <region left="18" top="1134" width="94" height="63" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Lower parameter search bounds [c0; c1; c2] for quadratic pressure fit</p>
      </content>
        </description>
        <input>
          <e type="operand">p.LB</e>
          <e type="operand">10</e>
          <e type="operator" args="1">-</e>
          <e type="operand">10</e>
          <e type="operator" args="1">-</e>
          <e type="operand">10</e>
          <e type="operator" args="1">-</e>
          <e type="operand">3</e>
          <e type="operand">1</e>
          <e type="function" args="5">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="1224" width="81" height="63" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
        <p>Upper parameter search bounds [c0; c1; c2] for quadratic pressure fit</p>
      </content>
        </description>
        <input>
          <e type="operand">p.UB</e>
          <e type="operand">10</e>
          <e type="operand">10</e>
          <e type="operand">10</e>
          <e type="operand">3</e>
          <e type="operand">1</e>
          <e type="function" args="5">mat</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="1323" width="318" height="42" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
            <p>A user defined function form. Continuous quadratic fitted pressure function P_fit(t) [bara]</p>
          </content>
        </description>
        <input>
          <e type="operand">t.sec</e>
          <e type="operand">P</e>
          <e type="function" args="2">P.model</e>
          <e type="operand">P</e>
          <e type="operand">1</e>
          <e type="function" args="2">el</e>
          <e type="operand">t.sec</e>
          <e type="operand">2</e>
          <e type="operator" args="2">^</e>
          <e type="operator" args="2">*</e>
          <e type="operand">P</e>
          <e type="operand">2</e>
          <e type="function" args="2">el</e>
          <e type="operand">t.sec</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">+</e>
          <e type="operand">P</e>
          <e type="operand">3</e>
          <e type="function" args="2">el</e>
          <e type="operator" args="2">+</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="1395" width="539" height="72" color="#000000" fontSize="10">
      <math>
        <description active="true" position="Top" lang="eng">
          <content>
            <p>Fitted parameters [P1; P2; P3]</p>
          </content>
        </description>
        <input>
          <e type="operand">P.coeff</e>
          <e type="operand">t.vec</e>
          <e type="operand">P.vec</e>
          <e type="operand">P.model</e>
          <e type="operand">p.LB</e>
          <e type="operand">p.UB</e>
          <e type="operand">15</e>
          <e type="operand">200</e>
          <e type="function" args="7">swarmfit</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">8.625</e>
          <e type="operand">10</e>
          <e type="operand">5</e>
          <e type="operator" args="1">-</e>
          <e type="operator" args="2">^</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="1">-</e>
          <e type="operand">0.1</e>
          <e type="operand">1.463</e>
          <e type="operand">3</e>
          <e type="operand">1</e>
          <e type="function" args="5">mat</e>
        </result>
      </math>
    </region>
    <region left="558" top="1404" width="100" height="29" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">t.0</e>
          <e type="operand">1</e>
          <e type="function" args="1">time</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="558" top="1467" width="120" height="29" color="#000000" fontSize="10">
      <math decimalPlaces="4">
        <description active="true" position="Top" lang="eng">
          <content>
