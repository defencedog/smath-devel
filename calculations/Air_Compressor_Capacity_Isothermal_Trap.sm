    <region left="18" top="2799" width="726" height="395" color="#000000" fontSize="10" showInputData="false">
      <xyplot animFrameRate="20" animPlaybackMode="RepeatIndefinitely" width="716" height="387" points="100" name="XYPlot" keepAspectRatio="false">
        <chartstyle usedefault="false" backcolor="White" bordercolor="Black" />
        <grid gridcolor="LightGray" gridpattern="Dash" gridthickness="1" isxgrid="true" isygrid="true" isy2grid="false" />
        <xaxes xmin="0" xmax="60" xtick="10" visible="True" decimalplaces="3" numberformat="General" />
        <yaxes ymin="-7.807066" ymax="77.80708" ytick="20" visible="True" decimalplaces="3" numberformat="General" />
        <y2axes isy2axis="true" y2min="0" y2max="10" y2tick="2" visible="True" decimalplaces="3" numberformat="General" />
        <title2d title="Figure 1: DCS Receiver Telemetry &amp; Curve Fitting Overlay" titlefont="DejaVu Sans, 10pt" titlefontcolor="Black" />
        <xylabel labelfont="DejaVu Sans, 10pt" labelfontcolor="Black" tickfont="DejaVu Sans, 8pt" tickfontcolor="Black" xlabel="Pump-Up Test Time t [s]" ylabel="Temperature [°C]" y2label="Pressure [barg]" />
        <legend isbordervisible="true" islegendvisible="true" legendbackcolor="200, 255, 255, 255" legendbordercolor="Black" legendfont="DejaVu Sans, 8pt" legendposition="SouthEast" textcolor="Black" />
        <traces>
          <trace seriesname="DCS Receiver Pressure P(t) [barg] (Measured)" isy2data="true" isvisible="true" plotmethod="Lines" lineantialias="true" linecolor="DodgerBlue" linethickness="1" linepattern="Solid" fillmode="Auto" filltotrace="-1" filled="false" hatched="false" fillcolor="64, 0, 0, 255" hatchstyle="Percent20" symbolantialias="true" symbolsize="8" symboltype="Box" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />
          <trace seriesname="DCS Gas Temperature T(t) [°C] (Measured)" isy2data="false" isvisible="true" plotmethod="Lines" lineantialias="true" linecolor="Crimson" linethickness="1" linepattern="Solid" fillmode="Auto" filltotrace="-1" filled="false" hatched="false" fillcolor="64, 0, 0, 255" hatchstyle="Percent20" symbolantialias="true" symbolsize="8" symboltype="Circle" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />
          <trace seriesname="Fitted Data T" isy2data="false" isvisible="true" plotmethod="Lines" lineantialias="true" linecolor="Red" linethickness="1" linepattern="Dot" fillmode="Auto" filltotrace="-1" filled="false" hatched="false" fillcolor="64, 0, 0, 255" hatchstyle="Percent20" symbolantialias="true" symbolsize="8" symboltype="None" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />
          <trace seriesname="Fitted Data P" isy2data="true" isvisible="true" plotmethod="Lines" lineantialias="true" linecolor="Blue" linethickness="1" linepattern="Dot" fillmode="Auto" filltotrace="-1" filled="false" hatched="false" fillcolor="64, 0, 0, 255" hatchstyle="Percent20" symbolantialias="true" symbolsize="8" symboltype="None" symbolborderthickness="1" symbolbordercolor="Black" symbolfillcolor="White" />
        </traces>
        <input>
          <e type="operand">t.vec</e>
          <e type="operand">P.vec</e>
          <e type="function" args="2">augment</e>
